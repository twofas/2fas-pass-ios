    "security_tiers_help_local_first_section_figure_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherheit deiner Daten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Security of your data"
          }
        },
        "pl" : {
          "stringUnit" : {
