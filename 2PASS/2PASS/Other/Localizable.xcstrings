    "settings_entry_protection_level_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Sicherheitsstufen wählst du, wie sicher jeder Eintrag sein soll. Du kannst einstellen, wie verschiedene Einträge mit dem automatischen Ausfüllen sowie der Browser-Erweiterung umgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Security Tiers, you decide how to use individual Items with Autofill and share them with the 2FAS Pass Browser Extension."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki poziomom bezpieczeństwa decydujesz o dostępie autouzupełniania i rozszerzenia przeglądarki do każdego elementu."
          }
        }
      }
    },
    "settings_entry_protection_level0" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrem sicher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top Secret"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ściśle tajny"
          }
        }
      }
    },
    "settings_entry_protection_level0_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sicher** + Die Einträge sind in der Handy-App isoliert. \nAutomatisches Ausfüllen hat kein Zugriff auf die Daten.\nDie Browser-Erweiterung hat kein Zugriff auf die Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Secret** + Items are isolated in the mobile application.\nAutofill has no access to the Item.\nBrowser Extension has no access to the Item."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Poufny** + Elementy są odizolowane w aplikacji mobilnej.\nAutouzupełnianie nie ma dostępu do elementu.\nRozszerzenie przeglądarki nie ma dostępu do elementu."
          }
        }
      }
    },
    "settings_entry_protection_level1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr sicher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highly Secret"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tajny"
          }
        }
      }
    },
    "settings_entry_protection_level1_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sicher** + Eine zusätzliche Bestätigung.\nAutomatisches Ausfüllen erfordert eine Bestätigung.\nDie Browser-Erweiterung benötigt eine Bestätigung in der App, um auf Informationen zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
