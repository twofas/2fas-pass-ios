    "transfer_instructions_dashlane_mobile" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Dashlane App auf deinem Handy.\n\nGehe in die **Einstellungen** und dann zu **Generell**\n\nWähle die Option **Daten als CSV exportieren**.\n\nLade nun die Datei in die 2FAS Pass App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Dashlane on your mobile phone.\n\nGo to **Settings** and select **General**.\n\nSelect **Export data to CSV**, then confirm the export to a folder.\n\nCopy the exported **Dashlane CSV folder or specific files** to this device. \n\nTap **Upload folder or CSV file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Dashlane na urządzeniu mobilnym.\n\nPrzejdź do **Ustawień** i wybierz **Ogólne**.\n\nWybierz **Eksportuj dane do CSV**, a następnie potwierdź eksport do folderu.\n\nWybierz plik CSV oznaczony jako **credentials** w utworzonym folderze.\n\nSkopiuj wyeksportowany **folder Dashlane CSV lub pojedyńczy plik** na to urządzenie.\n\nKliknij **Wgraj folder/plik CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_dashlane_pc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Dashlane in deinem Browser.\n\nExpandiere das **Mein Account**-Menü und klicke auf **Einstellungen**.\n\nWähle nun **Daten exportieren** und dann **Als CSV exportieren**\n\nGebe nun dein Masterkennwort ein.\n\nExportiere die heruntergeladene Datei auf dein Handy und lade sie in die 2FAS Pass App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Dashlane on your browser.\n\nExpand the **My account** menu and select **Settings**.\n\nSelect **Export data** and **Export to CSV**.\n\nEnter your Master Password, select **Unlock** and **Continue**.\n\nFind the ZIP file saved in your default download location.\n\nCopy this file to this device and tap **Upload ZIP file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Dashlane w przeglądarce.\n\nRozwiń menu **Moje konto** i wybierz **Ustawienia**.\n\nWybierz **Eksportuj dane**, a następnie **Eksportuj do CSV**.\n\nWpisz swoje hasło główne, kliknij **Odblokuj** i **Kontunuuj**\n\nZnajdź plik ZIP zapisany w domyślnej lokalizacji pobierania.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik ZIP** poniżej."
          }
        }
      }
    },
    "transfer_instructions_enpass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Enpass auf deinem PC.\n\nÖffne das Menü oben rechts in der App.\n\nWähle **Datei** und dann **Exportieren.**\n\nWähle den richtigen Tresor und das Dateiformat JSON aus.\n\nWähle den Speicherort und bestätige den Export.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **JSON-Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Enpass on your PC.\n\nOpen the menu at the top right of the app.\n\nSelect **File** then **Export**.\n\nSelect the correct Vault and the **json** file format.\n\nChoose the location and confirm the export.\n\nCopy the exported file to this device and tap **Upload JSON file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Enpass na komputerze.\n\nOtwórz menu w prawym górnym rogu.\n\nWybierz **Plik** a następnie **Eksportuj**.\n\nWybierz Sejf i **format json**.\n\nWybierz miejsce zapisu i potwierdź eksport.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik JSON** poniżej."
          }
        }
      }
    },
    "transfer_instructions_firefox" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Firefox auf deinem PC.\n\nWähle oben rechts die **Menüschaltfläche** (drei waagerechte Linien) und dann Passwörter.\n\nWähle das **Firefox-Menü** (drei Punkte) und dann **Passwörter exportieren**.\n\nWähle **Export fortsetzen** und lege den Dateinamen sowie den Speicherort fest.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **CSV-Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Firefox on your PC\n\nSelect the **Menu button** (3 horizontal lines) at the top right, then select **Passwords**.\n\nSelect **Firefox menu** (3 dots) and **Export Passwords**.\n\nSelect **Continue with export** and choose the file name and location.\n\nCopy the exported file to this device and tap **Upload CSV file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Firefox na komputerze.\n\nWybierz przycisk **Menu** (3 poziome linie) w prawym górnym rogu, a następnie wybierz **Hasła**.\n\nWybierz **Menu Firefoksa** (3 kropki) i **Eksportuj hasła**.\n\nWybierz **Kontynuuj eksport**, a następnie ustaw nazwę i lokalizację pliku.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_header %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertragen aus %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfer from %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfer z %@"
          }
        }
      }
    },
    "transfer_instructions_keepass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne KeePass auf deinem PC und melde dich bei deiner Datenbank an.\n\nKlicke in der Menüleiste auf **Datei** und wähle **Exportieren**.\n\nWähle das **Dateiformat** sowie den Speicherort aus und klicke auf **OK**.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open KeePass on your PC and log in to your database.\n\nClick **File** in the menu bar, and select **Export**.\n\nChoose the **file format**, the export location and click **OK**.\n\nCopy the exported file to this device and tap **Upload file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz KeePass na komputerze i zaloguj się do bazy danych.\n\nKliknij **Plik** na pasku menu i wybierz **Export**.\n\nWybierz **format pliku**, lokalizację eksportu i kliknij **OK**.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik** poniżej."
          }
        }
      }
    },
    "transfer_instructions_keepassxc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne KeePassXC auf deinem PC und melde dich bei deiner **Datenbank** an.\n\nKlicke in der **Menüleiste** auf Datenbank und wähle **Exportieren**.\n\nWähle das **Dateiformat**, bestätige die Auswahl, lege den Speicherort fest und klicke auf **OK**.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open KeePassXC on your PC and log in to your database.\n\nClick **Database** in the menu bar, and select **Export**.\n\nChoose the **file format**, confirm and choose the export location and click **OK**.\n\nCopy the exported file to this device and tap **Upload file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz KeePassXC na komputerze i zaloguj się do bazy danych.\n\nKliknij **Baza danych** na pasku menu i wybierz **Export**.\n\nWybierz **format pliku**, lokalizację eksportu i kliknij **OK**.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik** poniżej."
          }
        }
      }
    },
    "transfer_instructions_keeper" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Keeper auf deinem PC.\n\nKlicke oben rechts auf dein Konto, wähle **Einstellungen** und gehe zu **Exportieren**.\n\nWähle unter **Datei exportieren** das **Dateiformat** JSON aus und klicke auf **Exportieren**.\n\nGib dein Master-Passwort ein und bestätige den Export.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **JSON-Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Keeper on your PC.\n\nClick on your account in the top right corner, select **Settings**, and go to **Export**\n\nUnder **Export file**, select **json** as the file format and click **Export**.\n\nEnter your Master Password and confirm the export.\n\nCopy the exported file to this device and tap **Upload JSON file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Keeper na komputerze.\n\nKliknij na twoje konto w prawym górnym rogu, wybierz **Ustawienia**, a następnie **Eksport**.\n\nW **Eksport pliku** wybierz **format json** a następnie kliknij **Eksportuj**.\n\nWpisz swoje hasło główne i potwierdź eksport.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik JSON** poniżej."
          }
        }
      }
    },
    "transfer_instructions_lastpass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei LastPass in deinem Browser an und gehe dann in das **Advanced Options**-Menü.\n\nUnter dem Begriff **Verwalte deinen Tresor** wählst du **Exportieren**.\n\n Öffne die erhaltene E-Mail und klicke auf **Exportieren fortfahren**.\n\nGehe dann zurück zu dem LastPass fenster, gebe dein Masterpasswort ein und lade die CSV Datei herunter.\n\nBitte kopiere die Datei auf dein Mobilgerät und lade sie anschließend in der 2FAS Pass App hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in to LastPass on your browser and go to **Advanced Options**.\n\nUnder **Manage Your Vault**, select **Export**. This will send you a verification email.\n\nOpen the received mail and select **Continue export**.\n\nBack in the export window, enter your Master Password and save the **CSV file**.\n\nCopy the exported file to this device and tap **Upload CSV file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się do LastPass w przeglądarce i przejdź do **Opcji zaawansowanych**.\n\nW sekcji **Zarządzaj swoim sejfem** wybierz **Eksportuj**. Spowoduje to wysłanie e-maila weryfikacyjnego.\n\nOtwórz otrzymaną wiadomość i wybierz **Kontynuuj eksport**.\n\nW oknie eksportu wpisz swoje hasło główne i zapisz **plik CSV**.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_microsoft_edge" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne **Microsoft Edge** auf deinem PC.\n\nWähle oben rechts die **drei Punkte** neben deinem **Profilsymbol** und dann **Passwörter**.\n\nWähle die drei Punkte neben „Passkey“, klicke auf **Passwörter exportieren** und bestätige den Export.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **CSV-Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Microsoft Edge on your PC\n\nSelect the 3 dots next to your profile icon at the top right, then select **Passwords**.\n\nSelect the 3 dots next to Passkey, click **Export passwords** and confirm the export.\n\nCopy the exported file to this device and tap **Upload CSV file** below. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Microsoft Edge na komputerze.\n\nWybierz 3 kropki obok ikony profilu w prawym górnym rogu, a następnie wybierz **Hasła**.\n\nWybierz 3 kropki obok kluczy dostępu, kliknij **Eksportuj hasła** i potwierdź eksport.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_nordpass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne NordPass auf deinem PC.\n\nGehe zu den **Einstellungen** und suche den Bereich **Importieren und Exportieren**.\n\nWähle **Elemente exportieren**, gib dein Master-Passwort ein und bestätige den Export.\n\nKopiere die exportierte Datei auf dieses Gerät und tippe unten auf **CSV-Datei hochladen**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open NordPass on your PC.\n\nGo to **Settings** and find the **Import and Export** section.\n\nSelect **Export items**, enter your master password and confirm the export.\n\nCopy the exported file to this device and tap **Upload CSV file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz NordPass na komputerze.\n\nPrzejdź do **Ustawień** i przewiń w dół do sekcji **Import i Eksport**.\n\nWybierz **Eksportuj elementy**, wpisz swoje hasło główne i potwierdź eksport.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_onepassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne 1Passwort auf deinem PC.\n\nKlicke auf die drei Punkte der Sidebar, wähle **Exportieren** und dann den Account, den du exportieren möchtest.\n\nGebe dein Account Passwort ein.\n\nWähle entweder das **1PUX** Format oder das **CSV** Format und wähle **Daten exportieren**\n\nKopiere die Datei nun auf dieses Gerät und klicke dann auf **1PUX/CSV Datei hochladen**"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open 1Password on your PC.\n\nClick the three dots at the top of the sidebar, select **Export** and choose the account you want to export (on Mac select a specific Vault).\n\nEnter your account password.\n\nChoose the **1PUX or CSV format** and select **Export data**.\n\nCopy the exported file to this device and tap **Upload 1PUX/CSV file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz 1Passoword na komputerze.\n\nKliknij trzy kropki u góry paska bocznego, wybierz **Eksportuj** i wskaż konto, które chcesz wyeksportować (na Macu wybierz konkretny Sejf).\n\nWprowadź hasło do swojego konta.\n\nWybierz **format 1PUX lub CSV** i kliknij **Eksportuj dane**.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik 1PUX/CSV** poniżej."
          }
        }
      }
    },
    "transfer_instructions_protonpass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Proton Pass über die Browser-Erweiterung, Website oder dem Windows-Programm.\n\nKlicke auf das **Proton Logo**, wähle **Einstellungen** und dann \"Exportieren\".\n\nWähle entweder **das ZIP oder das CSV Format** und klicke dann auf **Exportieren**\n\nBitte kopiere die Datei nun auf dein Mobilgerät und lade sie anschließend in der 2FAS Pass App hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Proton Pass via their browser extension, web app or Windows app.\n\nClick the **Proton Pass Logo**, select **Settings**, then **Export**.\n\nChoose the **ZIP or CSV format** and select **Export**.\n\nFind the saved file in your default download location.\n\nCopy this file to this device and tap **Upload ZIP/CSV file** below."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Proton Pass za pomocą rozszerzenia przeglądarki, aplikacji webowej lub aplikacji Windows.\n\nKliknij **Logo Proton Pass**, wybierz **Ustawienia** następnie **Export**.\n\nWybierz **format ZIP lub CSV** i kliknij **Eksportuj**.\n\nZnajdź zapisany plik w domyślnej lokalizacji pobierania.\n\nSkopiuj wyeksportowany plik na to urządzenie i kliknij **Wgraj plik ZIP/CSV** poniżej."
          }
        }
      }
    },
    "transfer_services_list_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge bitte den Anleitungen, wenn du Einträge von anderen Passwortmanagern importieren willst.\n\nAlle Produktnamen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Die Verwendung dieser Namen bedeutet keine Zugehörigkeit zu oder Billigung durch diese."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please follow the instructions if you would like to transfer passwords from other applications into 2FAS Pass.\n\nAll product names, logos, and brands are the property of their respective owners. Use of these names does not imply any affiliation with or endorsement by them."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postępuj zgodnie z instrukcjami, aby zaimportować hasła z innych aplikacji do 2FAS Pass.\n\nWszystkie nazwy produktów, logotypy i marki są własnością ich odpowiednich właścicieli. Użycie tych nazw nie oznacza żadnego powiązania ani rekomendacji z ich strony."
          }
        }
      }
    },
