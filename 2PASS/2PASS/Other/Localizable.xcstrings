    "auth_biometrics_disabled_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die biometrische Entsperrung wurde deaktiviert, da sich deine Fingerabdruck-Einstellungen geändert haben. Bitte melde dich mit deinem Master-Passwort an, um die Funktion wieder zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrics are disabled due to changes in system fingerprint settings. Use your Master Password to re-enable biometrics in settings."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biomatria została wyłączona z powodu zmian w ustawieniach odcisków palców systemu. Użyj hasła głównego, aby ponownie włączyć biometrię w ustawieniach."
          }
        }
      }
    },
