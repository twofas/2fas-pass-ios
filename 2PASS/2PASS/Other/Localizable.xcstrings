      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilf uns bei der Identifizierung von Fehlern, indem du anonym Crash Reports an uns schickst (die App wird dabei neu gestartet)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help 2FAS Pass identify and resolve application problems by submitting anonymous crash reports (application restart required)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomóż 2FAS Pass w identyfikacji i rozwiązywaniu problemów, wysyłając anonimowe raporty o awariach (wymagane ponowne uruchomienie aplikacji)."
          }
        }
      }
