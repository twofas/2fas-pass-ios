    "settings_entry_screen_recording_confirm_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Option erlaubt das Aufzeichnen von App-Inhalten. Sie ermöglicht zudem externe Versuche, den Bildschirm zu erfassen. Um die Sicherheit zu gewährleisten, schaltet sich diese Option nach %d Minuten automatisch aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This option allows recording of app content. It will also enable any external attempts to capture the screen. To ensure safety, this option will automatically turn off after %d minutes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta opcja pozwala na nagrywanie zawartości aplikacji. Jednocześnie umożliwia zewnętrznym aplikacjom przechwytywanie ekranu. Aby zapewnić bezpieczeństwo, opcja ta wyłączy się automatycznie po %d minutach."
          }
        }
      }
    },
    "settings_entry_screen_recording_confirm_title" : {
