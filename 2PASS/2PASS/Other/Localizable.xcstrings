    "uri_settings_modal_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede in deinem Element aufbewahrte Website- oder App-Adresse (URI) kann eine bestimmte Übereinstimmungsregel haben. Diese Regel bestimmt, wann 2FAS Pass deine Eintragungen vorschlägt, basierend darauf, wie genau die aktuelle Adresse mit der gespeicherten URI übereinstimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each website or app address (URI) saved in your Item can have a specific matching rule. This rule determines when 2FAS Pass will suggest your Item information based on how closely the current address matches the saved URI."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy adres strony lub aplikacji (URI) zapisany w elemencie może mieć określoną regułę dopasowania. Reguła ta decyduje, kiedy 2FAS Pass zasugeruje informacje z elementu, w zależności od tego, jak dokładnie bieżący adres odpowiada zapisanemu URI."
          }
        }
      }
    },
