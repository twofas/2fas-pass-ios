          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the number of failed Master Password attempts that will lock the application for the specified time."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw liczbę nieudanych prób wpisania hasła głównego, po której aplikacja zostanie zablokowana na określony czas."
          }
        }
      }
    },
