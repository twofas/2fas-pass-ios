    "settings_entry_app_lock_attempts_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Anzahl von falschen Versuchen wird die App für 1 Minute gesperrt. Die Zeit steigert sich jedes Mal, wenn man das Passwort wiederholt falsch eingibt. Die Zeitabstände sind: 3 Min, 5 Min, 15 Min, 1 Std."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After this number of failed attempts, the application will be locked for 1 minute. It will increase progressively to 3 minutes, 5 minutes, 15 minutes, up to 1 hour."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po tej liczbie nieudanych prób logowania aplikacja zostanie zablokowana na 1 minutę. Czas blokady będzie stopniowo wydłużany do 3, 5 i 15 minut, aż do 1 godziny."
          }
        }
      }
    },
    "settings_entry_app_lock_attempts_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
