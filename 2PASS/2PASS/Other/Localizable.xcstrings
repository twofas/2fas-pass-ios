        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das Masterkennwort änderst, wird dein Tresor neu verschlüsselt. Daher musst du: **Dein neues Entschlüsselungskit herunterladen (das alte Entschlüsselungskit ist nicht mehr gültig) und eine neue lokale Datensicherung erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
