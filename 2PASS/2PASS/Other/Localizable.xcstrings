    "settings_entry_screenshots_confirm_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du Bildschirmfotos sowie Aufnahmen zulassen willst? Diese Funktion erlaubt es dir, in den nächsten 5 Minuten Bildschirmfotos sowie Aufnahmen von der App zu machen, allerdings erlaubt sie auch alle externen Versuche, Bildschirmfotos von der App zu machen. Aus Sicherheitsgründen wird diese Funktion nach 5 Minuten wieder automatisch deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? This option lets you screenshot and record anything within the app. However, it will also enable any external attempts to capture screens in the app. To ensure safety, this option will automatically turn off after 5 minutes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś pewien? Ta opcja pozwala na wykonywanie zrzutów ekranu i nagrywanie wszystkiego w aplikacji. Jednocześnie umożliwia ona próby przechwycenia ekranu przez zewnętrzne aplikacje. Aby zapewnić bezpieczeństwo, opcja ta wyłącza się automatycznie po 5 minutach."
          }
        }
      }
    },
