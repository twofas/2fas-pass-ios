      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tresor wurde in dieser Datensicherung gefunden, allerdings ist er mit einem anderen Gerät verbunden. Bitte ändere deinen Tarif, um die Geräte-Sync Funktion freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matching Vault exists in the backup but is linked to another device. Upgrade your plan to enable multi-device sync."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasujący sejf istnieje w kopii zapasowej, ale jest powiązany z innym urządzeniem. Ulepsz swój plan, aby włączyć synchronizację między wieloma urządzeniami."
          }
        }
      }
    },
