          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Security Tiers"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Poziomy bezpieczeństwa"
          }
        }
      }
    },
    "security_tiers_help_tiers_top_secret_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge, die der Stufe „Extrem sicher“ (Top Secret Tier) zugewiesen sind, sind isoliert und können nicht mit Autofill oder der 2FAS Pass Browser-Erweiterung verwendet werden. Sie müssen manuell eingegeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items assigned to the Top Secret Tier are isolated and cannot be used with Autofill or 2FAS Pass Browser Extension. They must be entered manually."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ściśle tajne elementy są odizolowane i nie mogą być używane z autouzupełnianiem ani z rozszerzeniem przeglądarki 2FAS Pass. Muszą być wpisywane ręcznie."
          }
        }
      }
    },
